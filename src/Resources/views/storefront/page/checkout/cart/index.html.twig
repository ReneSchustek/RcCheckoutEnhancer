{% sw_extends '@Storefront/storefront/page/checkout/cart/index.html.twig' %}

{% block base_main_inner %}
    {% sw_include '@RcCheckoutEnhancer/storefront/component/rc-checkout/progress-bar.html.twig' %}
    {% sw_include '@RcCheckoutEnhancer/storefront/component/rc-checkout/trust-badges.html.twig' %}
    {{ parent() }}
{% endblock %}

{# Versandkostenfrei-Indikator und Versandkostenrechner hängen an der Positionstabelle:
   Der Hinweis steht über dem Warenkorb, der Rechner darunter. Beide erscheinen nur, wenn
   ihr jeweiliger Subscriber seine Angaben angehängt hat — ist der Schalter aus, gibt es
   die Erweiterung nicht, und hier bleibt nichts stehen. #}
{% block page_checkout_cart_product_table %}
    {% if page.extensions.rcFreeShipping is defined %}
        {% block page_checkout_cart_rc_free_shipping %}
            {% sw_include '@RcCheckoutEnhancer/storefront/component/rc-checkout/free-shipping-hint.html.twig' %}
        {% endblock %}
    {% endif %}

    {{ parent() }}

    {% if page.extensions.rcCartAccessories is defined %}
        {% block page_checkout_cart_rc_accessories %}
            {% sw_include '@RcCheckoutEnhancer/storefront/component/rc-checkout/cart-accessories.html.twig' %}
        {% endblock %}
    {% endif %}

    {% if page.extensions.rcShippingEstimate is defined %}
        {% block page_checkout_cart_rc_shipping_estimate %}
            {% set rcShippingEstimate = page.extensions.rcShippingEstimate %}
            {% sw_include '@RcCheckoutEnhancer/storefront/component/rc-checkout/shipping-estimate.html.twig' %}
        {% endblock %}
    {% endif %}
{% endblock %}
