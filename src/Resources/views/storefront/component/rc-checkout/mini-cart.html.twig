{% set rc = page.extensions.rcCheckoutEnhancer %}
{# Vergleichsgruppe eines laufenden A/B-Tests: Dieser Baustein bleibt weg. Die
   Entscheidung fällt beim Rendern, weil der Verkaufskanal-Kontext beim Seitenaufbau
   noch nicht steht — siehe ab-suppressed.html.twig. #}
{% set rcSuppressed = rc and rc.abActive ? include('@RcCheckoutEnhancer/storefront/component/rc-checkout/ab-suppressed.html.twig')|trim == '1' : false %}
{% if not rcSuppressed and rc and rc.miniCartEnabled %}
    {% set cart = page.cart %}
    {% set lineItems = cart.lineItems.filterType('product') %}

    <div class="rc-checkout-mini-cart card mb-3">
        <div class="card-header">
            {# `aria-controls` benennt den Bereich, den der Schalter auf- und zuklappt. Ohne die
               Angabe weiß eine Vorlesehilfe zwar, dass hier etwas ausklappt, aber nicht was —
               `aria-expanded` allein beschreibt einen Zustand ohne Gegenstand.

               Das ▾ ist Schmuck und trägt keine Aussage: Der Zustand steht bereits in
               `aria-expanded`. Ohne `aria-hidden` läse eine Vorlesehilfe zusätzlich
               „Dreieck nach unten" vor. #}
            <button class="btn btn-link w-100 text-start text-decoration-none d-flex justify-content-between align-items-center"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#rcMiniCartCollapse"
                    aria-controls="rcMiniCartCollapse"
                    aria-expanded="true">
                <strong>{{ 'rcCheckout.miniCartTitle'|trans({'%count%': lineItems.count}) }}</strong>
                <span class="rc-checkout-mini-cart__toggle-icon" aria-hidden="true">▾</span>
            </button>
        </div>

        <div class="collapse show" id="rcMiniCartCollapse">
            <div class="card-body p-2">
                {# Positionen über das Core-Template rendern statt über eigenes Markup.
                   Grund: Plugins hängen ihre Positionsangaben an die Blöcke dieses Templates —
                   RcColorPicker etwa die gewählte RAL-Farbe an
                   `component_line_item_type_product_label`. Eigenes Markup umgeht diesen
                   Erweiterungspunkt: Solange die Leiste die einzige Warenkorb-Darstellung auf der
                   Seite ist, fehlte dem Kunden die Farbe genau auf der Seite, auf der er bestätigt.

                   `displayMode: 'offcanvas'` ist die kompakte Core-Variante, die auch der
                   Offcanvas-Warenkorb nutzt — dieselbe Darstellung, die der Kunde schon kennt.
                   Ändern-/Entfernen-Wege bleiben aus: Die Leiste zeigt den Warenkorb, sie
                   bearbeitet ihn nicht. #}
                <ul class="rc-checkout-mini-cart__items list-unstyled mb-0">
                    {% for lineItem in lineItems %}
                        {# `showSubtotal: true`, obwohl die Leiste die Summe darunter noch einmal
                           nennt: Der Positionspreis ist der Block, an dem Preis-Erweiterungen
                           hängen. RcDualPrice setzt seinen Netto-Zweitpreis in
                           `component_line_item_type_product_col_total_price`. Mit `false` rendert
                           der Core diesen Block gar nicht -- gemessen: Warenkorb zeigt den
                           Zweitpreis zweimal, die Confirm-Seite keinmal. Das ist derselbe Fehler
                           wie bei der Farbe, nur eine Ebene tiefer: Nicht das eigene Markup umging
                           den Erweiterungspunkt, sondern ein abgeschalteter Block. #}
                        {% sw_include '@Storefront/storefront/component/line-item/type/product.html.twig' with {
                            lineItem: lineItem,
                            displayMode: 'offcanvas',
                            showRemoveButton: false,
                            showSubtotal: true,
                            nestingLevel: 0
                        } %}
                    {% endfor %}
                </ul>

                <hr class="my-2">

                <div class="d-flex justify-content-between small">
                    <span>{{ 'rcCheckout.miniCartSubtotal'|trans }}</span>
                    <span>{{ cart.price.positionPrice|currency }}</span>
                </div>

                {% for delivery in cart.deliveries %}
                    <div class="d-flex justify-content-between small text-muted">
                        <span>{{ 'rcCheckout.miniCartShipping'|trans }}</span>
                        <span>{{ delivery.shippingCosts.totalPrice|currency }}</span>
                    </div>
                {% endfor %}

                <div class="d-flex justify-content-between fw-bold mt-1">
                    <span>{{ 'rcCheckout.miniCartTotal'|trans }}</span>
                    <span>{{ cart.price.totalPrice|currency }}</span>
                </div>
            </div>
        </div>
    </div>
{% endif %}
