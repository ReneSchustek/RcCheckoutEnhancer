{% sw_extends '@Storefront/storefront/component/checkout/offcanvas-cart.html.twig' %}

{# Zubehör unter den Positionen der Leiste, gedrängt: eine Zeile je Produkt, Bild links, Name und Preis daneben. #}
{% block component_offcanvas_cart_items %}
    {{ parent() }}

    {% if page.extensions.rcCartAccessories is defined %}
        {% block component_offcanvas_cart_rc_accessories %}
            {% sw_include '@RcCheckoutEnhancer/storefront/component/rc-checkout/cart-accessories.html.twig' with { rcAccCompact: true } %}
        {% endblock %}
    {% endif %}
{% endblock %}

{% block component_offcanvas_cart_actions %}
    {% if page.extensions.rcFreeShipping is defined %}
        {% block component_offcanvas_cart_rc_free_shipping %}
            {% sw_include '@RcCheckoutEnhancer/storefront/component/rc-checkout/free-shipping-hint.html.twig' with { rcFsOffcanvas: true } %}
        {% endblock %}
    {% endif %}

    {% if page.extensions.rcOffcanvasShipping is defined %}
        {% set rcShip = page.extensions.rcOffcanvasShipping %}
        {% block component_offcanvas_cart_rc_shipping_estimate %}
            {# Die zuletzt errechnete Auskunft, wenn es eine gibt, darunter der Rechner. Beides
               steht über der Schaltfläche zur Kasse, damit man es ohne Scrollen sieht.

               Damit der Weg zur Kasse nicht nach unten rutscht, ist der Rechner zugeklappt, und
               die Schaltfläche klebt am unteren Rand der Leiste (`base.scss`). Aufgeklappt
               schöbe er sie bei 800 px Fensterhöhe aus dem sichtbaren Bereich. #}
            <div class="rc-offcanvas-shipping mb-2" data-rc-offcanvas-shipping>
                {% if rcShip.state == constant('Ruhrcoder\\RcCheckoutEnhancer\\Subscriber\\OffcanvasShippingEstimateSubscriber::STATE_VALID') %}
                    <p class="rc-offcanvas-shipping__known alert alert-light mb-0" role="status">
                        {{ "rc-checkout.offcanvasShipping.known"|trans({
                            '%country%': rcShip.estimate.countryIso,
                            '%zip%': rcShip.estimate.zipCode,
                            '%price%': rcShip.estimate.price|currency(rcShip.estimate.currencyIsoCode),
                        }) }}
                        <small class="rc-offcanvas-shipping__method d-block">{{ rcShip.estimate.shippingMethodName }}</small>
                    </p>
                {% elseif rcShip.state == constant('Ruhrcoder\\RcCheckoutEnhancer\\Subscriber\\OffcanvasShippingEstimateSubscriber::STATE_STALE') %}
                    {# Ohne Preis: Der gespeicherte gilt für einen anderen Warenkorb, und ein
                       veralteter Versandpreis ist eine Zusage, die der Shop nicht hält. Neu
                       rechnen lässt sich mit dem Rechner darunter. #}
                    <p class="rc-offcanvas-shipping__stale alert alert-light mb-0" role="status">
                        {{ "rc-checkout.offcanvasShipping.stale"|trans }}
                    </p>
                {% endif %}
            </div>
        {% endblock %}
    {% endif %}

    {# Derselbe Baustein wie auf der Warenkorbseite, mit derselben Berechnung und demselben
       Skript; ein zweiter Rechenweg liefe auseinander. #}
    {% if page.extensions.rcShippingEstimate is defined %}
        {% block component_offcanvas_cart_rc_shipping_estimate_form %}
            {% set rcShippingEstimate = page.extensions.rcShippingEstimate %}
            {# Zugeklappt: eine Zeile statt rund 280 Pixel. `<details>` statt eines eigenen
               Schalters, weil Tastatur und Sprachausgabe Auf und Zu so ohne Skript vom Browser
               bekommen. Das Ergebnis tauscht nur die Liste im Inneren aus, der Kasten bleibt
               dabei offen. #}
            <details class="rc-offcanvas-estimate mb-2" data-rc-offcanvas-estimate>
                <summary class="rc-offcanvas-estimate__toggle">
                    {{ "rc-checkout.offcanvasShipping.toggle"|trans }}
                </summary>
                {% sw_include '@RcCheckoutEnhancer/storefront/component/rc-checkout/shipping-estimate.html.twig' with { rcEstimateStacked: true } %}
            </details>
        {% endblock %}
    {% endif %}

    {{ parent() }}

{% endblock %}
