{% block cms_form_contact_comment_textarea %}
    {% set rcEnquiry = page.extensions.rcShippingEnquiry ?? null %}
    {% set rcEnquirySummary = rcEnquiry ? rcEnquiry.summary : null %}

    {% if rcEnquirySummary %}
        {# Der eingestellte Text schlägt den Textbaustein, wie bei jedem Baustein dieses
           Plugins. Beide leer heißt: nur die Aufstellung — auch das ist eine Einstellung. #}
        {% set rcIntro = rcEnquiry.intro ?: 'rcCheckout.enquiryIntro'|trans %}
        {% set rcComment = rcIntro|trim ? rcIntro|trim ~ "\n\n" ~ rcEnquirySummary : rcEnquirySummary %}

        <div class="col-12">
            <div class="rc-shipping-enquiry-note alert alert-info" role="status">
                {{ 'rcCheckout.enquiryCartTaken'|trans }}
            </div>
        </div>

        {% sw_include '@Storefront/storefront/component/form/form-textarea.html.twig' with {
            label: 'contact.commentLabel'|trans,
            id: formPrefix ~ '-form-comment',
            name: 'comment',
            value: rcComment,
            placeholder: 'contact.commentPlaceholder'|trans,
            violationPath: '/comment',
            validationRules: 'required',
            rows: 16,
            additionalClass: 'col-12',
        } %}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}
