{% sw_extends '@Storefront/storefront/element/cms-element-form/form-types/contact-form.html.twig' %}

{# Befüllt das Kontaktformular, wenn der Kunde über den Anfrageweg aus dem Bestellvorgang
   hierherkommt: Anschreiben und Warenkorb im Kommentarfeld, seine eigenen Daten in den
   Feldern darüber.

   Sichtbar und änderbar, nicht in versteckten Feldern: Der Kunde soll wissen, was er
   absendet — und er soll es ergänzen können. Versteckte Felder wären bequemer und falsch.

   **Diese Vorlage liegt auf jeder Kontaktseite, nicht nur auf der aus dem Bestellvorgang
   aufgerufenen.** Ohne Übernahme bleibt deshalb jeder Block beim Kern (`{{ parent() }}`).
   Das ist die eine Stelle, an der dieses Plugin jede gewöhnliche Kontaktanfrage
   beschädigen könnte.

   Das Wabenfeld der Spam-Abwehr wird nicht angefasst: Es steht in einem eigenen Block
   (`cms_form_contact_captcha`), ist ausgeblendet und muss leer bleiben. Vorbelegt werden
   ausschließlich die sichtbaren Felder. #}

{% block cms_form_contact_select_salutation %}
    {% set rcEnquiry = page.extensions.rcShippingEnquiry ?? null %}
    {% set rcSalutationId = rcEnquiry ? (data.get('salutationId') ?: rcEnquiry.customer.salutationId ?? null) : null %}

    {% if rcSalutationId %}
        {% set rcSalutationOptions %}
            {% for salutation in element.data %}
                <option value="{{ salutation.id }}"{% if salutation.id == rcSalutationId %} selected="selected"{% endif %}>
                    {{ salutation.translated.displayName }}
                </option>
            {% endfor %}
        {% endset %}

        {% sw_include '@Storefront/storefront/component/form/form-select.html.twig' with {
            label: 'account.personalSalutationLabel'|trans|sw_sanitize,
            id: formPrefix ~ '-form-Salutation',
            name: 'salutationId',
            options: rcSalutationOptions,
            violationPath: '/salutationId',
            validationRules: 'required',
            additionalClass: 'col-md-4',
            additionalSelectClass: 'contact-select',
        } %}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block cms_form_contact_input_first_name %}
    {% set rcEnquiry = page.extensions.rcShippingEnquiry ?? null %}
    {% set rcFirstName = rcEnquiry ? (data.get('firstName') ?: rcEnquiry.customer.firstName ?? null) : null %}

    {% if rcFirstName %}
        {% sw_include '@Storefront/storefront/component/form/form-input.html.twig' with {
            label: 'account.personalFirstNameLabel'|trans,
            id: formPrefix ~ '-form-firstName',
            name: 'firstName',
            value: rcFirstName,
            placeholder: 'account.personalFirstNamePlaceholder'|trans,
            autocomplete: 'section-personal given-name',
            violationPath: '/firstName',
            validationRules: config('core.basicInformation.firstNameFieldRequired') ? 'required' : null,
            additionalClass: 'col-md-4',
        } %}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

