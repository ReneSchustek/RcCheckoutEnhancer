includes:
    - vendor/shopwarelabs/phpstan-shopware/rules.neon

parameters:
    level: 8
    paths:
        - src
        - tests
        - benchmarks
    excludePaths:
        - vendor
    # Optionale A/B-Integration: RcAbTesting ist keine harte Abhängigkeit
    # (Runtime via on-invalid="null"). PHPStan bekommt die referenzierten Symbole über
    # lokale Stubs statt über den Nachbar-Plugin-Pfad -- so läuft die Analyse
    # auch im CI, wo nur dieses Plugin ausgecheckt ist.
    scanFiles:
        - phpstan-stubs/RcAbTesting.php
    bootstrapFiles:
        - vendor/autoload.php
    ignoreErrors:
        # In Tests gibt es keinen Aufrufer, aus dem sich ein Kontext ableiten ließe. Ein
        # aufgebauter Nutzerkontext täuschte eine Abhängigkeit vor, die der Test nicht hat.
        -
            message: '#Do not use Shopware\\Core\\Framework\\Context::createDefaultContext#'
            path: tests/*
